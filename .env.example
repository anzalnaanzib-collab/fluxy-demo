# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never put real values in this file or in GitHub.

# Required: a long random secret (40+ characters) that signs the demo session cookie.
FLUXY_SESSION_SECRET=

# Demo codes: CODE:Label:dailyAnswerLimit, separated by commas. Codes 6+ characters.
# Example shape: ABCD-1234:Investor demo:60,EFGH-5678:Team:100
FLUXY_DEMO_CODES=
# Owner code (12+ characters): opens /owner, the status page.
FLUXY_OWNER_CODE=

# Free AI keys. Add at least one. Fluxy tries them in this order.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: change models without touching code (defaults are in lib/config.ts).
# GEMINI_MODEL_QUICK=
# GEMINI_MODEL_DEFAULT=
# GROQ_MODEL_QUICK=
# GROQ_MODEL_DEFAULT=
# OPENROUTER_MODEL_QUICK=
# OPENROUTER_MODEL_DEFAULT=
# FLUXY_PER_MINUTE=20

# Optional: Supabase database (free). Without it, limits are kept in memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: protects the daily cleanup job (any long random text).
CRON_SECRET=
