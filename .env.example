# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never put real values in this file or in GitHub.

# Required: a long random secret (40+ characters) that signs the demo session cookie.
FLUXY_SESSION_SECRET=

# Demo codes: CODE:Label:dailyAnswerLimit, separated by commas. Codes 6+ characters.
# Example shape: ABCD-1234:Investor demo:60,EFGH-5678:Team:100
FLUXY_DEMO_CODES=
# Owner code (12+ characters): opens /owner, the status page.
FLUXY_OWNER_CODE=

# Free AI keys. Add at least one. Fluxy tries them in this order.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: change models without touching code (defaults are in lib/config.ts).
# GEMINI_MODEL_QUICK=
# GEMINI_MODEL_DEFAULT=
# GROQ_MODEL_QUICK=
# GROQ_MODEL_DEFAULT=
# OPENROUTER_MODEL_QUICK=
# OPENROUTER_MODEL_DEFAULT=
# FLUXY_PER_MINUTE=20

# Optional: Supabase database (free). Without it, limits are kept in memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: protects the daily cleanup job (any long random text).
CRON_SECRET=

# ---------------- Paid backups (optional, pay-as-you-go) ----------------
# Only used after every free AI is out for the day, and only while this month's
# paid spend is under the cap. Needs the Supabase database (so spending is never forgotten).
# Monthly cap for ALL paid AIs together, in US dollars. 0 or empty = paid AIs off.
FLUXY_PAID_MONTHLY_CAP_USD=
XAI_API_KEY=            # Grok  (console.x.ai)
ANTHROPIC_API_KEY=      # Claude (console.anthropic.com)
PERPLEXITY_API_KEY=     # Perplexity (perplexity.ai > API). Uses the new Agent API with live web search
GEMINI_PAID_API_KEY=    # a SEPARATE Google project with billing on; keep the free key above
OPENAI_API_KEY=         # ChatGPT (platform.openai.com)
# Optional: order of paid AIs, e.g. xai,anthropic,perplexity,gemini_paid,openai (this is the default)
# FLUXY_PAID_ORDER=
# Optional model / price overrides, e.g. XAI_MODEL, XAI_PRICE_IN, XAI_PRICE_OUT (USD per 1M tokens)

# Optional: how much "thinking" Gemini does (low keeps it fast). Set to off to never send it.
# GEMINI_REASONING=low

# Optional: live ads in research screens (Meta's official ads_archive API).
# A user access token from your Meta developer app. Long-lived tokens last about 60 days.
# Fluxy uses it quietly on research screens; users never see it as a separate feature.
# FLUXY_RESEARCH_PAGES=research,competitors,trends,insights,ads,strategy,visibility,creative-lab,campaigns
META_AD_LIBRARY_TOKEN=
# META_GRAPH_VERSION=v23.0
